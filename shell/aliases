# System
alias reloadcli="source $HOME/.zshrc"
alias pubkey="/bin/cat ~/.ssh/id_rsa.pub | pbcopy"
alias edithost="sudo pico /etc/hosts"
alias fuck='sudo $(history -p \!\!)'
alias finder="open -a 'Finder' ."
alias brewup='brew update && brew upgrade'

# Docker
alias docker-composer='docker-compose'
alias dockerhalt='docker stop $(docker ps -a -q)'
alias dockerrm='docker rm $(docker ps -a -q)'

# System
alias top='top -o cpu'
alias cc='clear'
alias spot='mdfind -onlyin `pwd`'
alias cleansvn='find . -name ".svn" -exec rm -rf {} \;'

# Laravel
alias art='php artisan'
alias tink='php artisan tinker'
alias migrate='php artisan migrate'

# Git
alias gc='git add . && git commit -m $1'
alias nah='git reset --hard && git clean -df'
alias gl='git log --all --graph --decorate --oneline --simplify-by-decoration'
