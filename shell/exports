# Make vim the default editor
export EDITOR="vim"

# UTF-8 everywhere. LANG only, so the macOS locale (Canadian currency and
# metric units) still applies to the other categories.
export LANG="en_US.UTF-8"

# Highlight section titles in manual pages (bold orange)
export LESS_TERMCAP_md=$'\e[1;33m'
export LESS_TERMCAP_me=$'\e[0m'

# Don’t clear the screen after quitting a manual page
export MANPAGER="less -X"

# Do not auto update brew, and never send usage analytics
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_ANALYTICS=1
