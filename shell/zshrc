# ============================================================
# Environment
# ============================================================
export SHELL_SESSIONS_DISABLE=1
export CLICOLOR=1

# ============================================================
# PATH
# ============================================================
BREW_PREFIX=$(brew --prefix)

export PATH="$BREW_PREFIX/bin:$BREW_PREFIX/sbin:$HOME/.dotfiles-custom/bin:$HOME/.composer/vendor/bin:$HOME/bin:$HOME/.yarn/bin:/Applications/PhpStorm.app/Contents/MacOS:$PATH"

# Keg-only Homebrew formulas that should shadow the macOS versions
for keg in curl; do
  [[ -d "$BREW_PREFIX/opt/$keg/bin" ]] && export PATH="$BREW_PREFIX/opt/$keg/bin:$PATH"
done

# GNU userland without the g prefix, for Linux compatible flags and behaviour
for gnu in coreutils findutils gnu-sed grep gawk gnu-tar; do
  [[ -d "$BREW_PREFIX/opt/$gnu/libexec/gnubin" ]] && export PATH="$BREW_PREFIX/opt/$gnu/libexec/gnubin:$PATH"
done

# Lerd (installed outside Homebrew, see setup/misc-defaults.sh)
export PATH="$HOME/.local/bin:$HOME/.local/share/lerd/bin:$PATH"

[[ -e ~/.phpbrew/bashrc ]] && source ~/.phpbrew/bashrc

# ============================================================
# Completions (fpath must be set before compinit)
# ============================================================
fpath+=("$HOME/.zsh/completions")
fpath+=("$BREW_PREFIX/share/zsh/site-functions")
fpath+=("$BREW_PREFIX/share/zsh-completions")
fpath+=("$HOME/.local/share/zsh/site-functions")

autoload -Uz compinit
if [[ -n ~/.zcompdump(#qNmh-24) ]]; then
  compinit -C
else
  compinit
fi

# ============================================================
# Prompt
# ============================================================
autoload -Uz promptinit
promptinit
prompt pure

# ============================================================
# SSH
# ============================================================
ssh-add -l &>/dev/null || ssh-add --apple-load-keychain 2>/dev/null

# ============================================================
# Dotfiles
# ============================================================
source ~/.zsh/git.plugin.zsh

for file in ~/.dotfiles/shell/{exports,aliases,functions}; do
  [ -r "$file" ] && [ -f "$file" ] && source "$file"
done

for file in ~/.dotfiles-custom/shell/{exports,aliases,functions,zshrc}; do
  [ -r "$file" ] && [ -f "$file" ] && source "$file"
done
unset file

# ============================================================
# Zsh plugins
# ============================================================
source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$BREW_PREFIX/share/zsh-vi-mode/zsh-vi-mode.zsh"

# ============================================================
# Tool integrations
# ============================================================
FNM_PATH="/opt/homebrew/opt/fnm/bin"
if [ -d "$FNM_PATH" ]; then
  eval "$(fnm env --shell zsh)"
fi

[[ -f "$HOME/.atuin/bin/env" ]] && . "$HOME/.atuin/bin/env"
# zsh-vi-mode rebinds keys after zshrc finishes, so atuin must init after it
# or Ctrl-R and the up arrow lose their atuin bindings.
if command -v atuin >/dev/null 2>&1; then
  zvm_after_init_commands+=('eval "$(atuin init zsh)"')
fi

# ============================================================
# zsh-patina (must stay last)
# ============================================================
eval "$(/opt/homebrew/opt/zsh-patina/bin/zsh-patina activate)"
