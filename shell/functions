# Run the project's test suite: pest if installed, otherwise phpunit
function p() {
    if [[ -x vendor/bin/pest ]]; then
        vendor/bin/pest "$@"
    elif [[ -x vendor/bin/phpunit ]]; then
        vendor/bin/phpunit "$@"
    else
        echo "No pest or phpunit in vendor/bin" >&2
        return 1
    fi
}

# Run only the tests whose name matches the given filter
function pf() {
    p --filter "$@"
}

# Open a path in PhpStorm, e.g. `phpstorm .`
# https://www.jetbrains.com/help/phpstorm/working-with-the-ide-features-from-command-line.html#toolbox
function phpstorm() {
    open -na "PhpStorm.app" --args "${@:-.}"
}

# Create a directory (and parents) and enter it
function mkd() {
    mkdir -p "$1" && cd "$1"
}

# Show the common DNS records for a domain in one listing.
# Queries each type separately because most resolvers now refuse ANY.
function dns() {
    local type
    for type in A AAAA CNAME MX NS TXT SOA; do
        dig +noall +answer "$1" "$type"
    done
}

# Forget SSH fingerprints, for when a server was rebuilt and ssh refuses to
# connect because the key changed. Takes any number of hosts, so both the
# name and the IP can be cleared at once. Non-standard ports are "[host]:port".
function removehost() {
    local host
    for host in "$@"; do
        ssh-keygen -R "$host"
    done
}

# Weather forecast in the terminal from wttr.in, defaults to Montreal
function weather() {
    curl -fsS "https://wttr.in/${1:-montreal}"
}

# Run Jekyll for the current directory inside a Podman container, nothing on
# the host. Uses the repo's Gemfile when present (GitHub Pages repos pin the
# github-pages gem there), otherwise installs github-pages. Gems are cached in
# a named volume so only the first run is slow.
#
#   jekyll              serve with watch + livereload on http://localhost:4000
#   jekyll build        build with watch into _site
#   jekyll <cmd> ...    any other jekyll command and flags
function jekyll() {
    local cmd="${1:-serve}"
    [[ $# -gt 0 ]] && shift

    local extra=""
    [[ "$cmd" == "serve" ]] && extra="--host 0.0.0.0 --livereload"
    [[ "$cmd" == "serve" || "$cmd" == "build" ]] && extra="$extra --watch --force_polling"

    podman run --rm -it \
        -v "$PWD:/srv/jekyll" -w /srv/jekyll \
        -v jekyll-gems:/usr/local/bundle \
        -p 4000:4000 -p 35729:35729 \
        -e JEKYLL_ENV=development \
        docker.io/library/ruby:3.3 \
        bash -c '
            if [ -f Gemfile ]; then
                bundle install --quiet && exec bundle exec jekyll "$@"
            else
                gem list -i github-pages >/dev/null || gem install --silent github-pages
                exec jekyll "$@"
            fi
        ' -- "$cmd" ${=extra} "$@"
}

# Create this machine's SSH key (one key per device) and register its public
# half in the private dotfiles so other machines set up from them accept it.
#
#   newsshkey            key named after this host, e.g. id_ed25519_mbp
#   newsshkey <name>     custom name, e.g. newsshkey id_ed25519_khronos
function newsshkey() {
    local name="${1:-id_ed25519_$(hostname -s)}"
    local key="$HOME/.ssh/$name"
    local keys_file="$HOME/.dotfiles-custom/ssh/authorized_keys"

    if [[ -f "$key" ]]; then
        echo "Key already exists: $key"
        return 1
    fi

    mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
    ssh-keygen -t ed25519 -f "$key" -C "$(whoami)@$(hostname -s)" || return 1
    ssh-add --apple-use-keychain "$key"

    if [[ -f "$keys_file" ]]; then
        cat "$key.pub" >> "$keys_file"
        echo
        echo "Public key appended to $keys_file"
        echo "Commit it in ~/.dotfiles-custom, then run setup/macos-defaults.sh on the other machine."
    else
        echo
        echo "Public key (no ~/.dotfiles-custom/ssh/authorized_keys found, add it by hand):"
        cat "$key.pub"
    fi
}
