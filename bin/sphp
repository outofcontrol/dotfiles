#!/usr/bin/env zsh

if [[ $# -eq 1 ]]; then
    VERSION=$1
else
    VERSION="5.6"
fi

BREW=$(which brew)

PHP_VERSION=$($BREW services list | /usr/bin/grep php | /usr/bin/awk '{print $1}')

for i in $PHP_VERSION;
do
    $BREW services stop $i
    $BREW unlink $i;
done;

$BREW link --force --overwrite php@$VERSION
$BREW services start php@$VERSION

# Restart Nginx
sudo $BREW services restart nginx

php -v
